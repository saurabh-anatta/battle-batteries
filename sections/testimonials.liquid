{%- liquid
  assign star_rating = section.settings.star_rating | default: '4.6'
  assign star_label = section.settings.star_label | default: 'Stars'
  assign heading = section.settings.heading
  assign description = section.settings.description

  assign tabs = section.blocks | where: 'type', 'tab'
  assign testimonials = section.blocks | where: 'type', 'testimonial'
-%}

<testimonials-component>
  <div
    class="section section--{{ section.settings.section_width }} testimonials spacing-style"
    style="
      --testimonials-bg: {{ section.settings.background_color }};
      --testimonials-active-tab: {{ section.settings.active_tab_color }};
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <div class="testimonials__inner">
      {%- comment -%} Star rating header {%- endcomment -%}
      <div class="testimonials__header">
        <div class="testimonials__stars-row">
          <div class="testimonials__stars" aria-hidden="true">
            <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 0L9.79611 5.52786H15.6085L10.9062 8.94427L12.7023 14.4721L8 11.0557L3.29772 14.4721L5.09383 8.94427L0.391548 5.52786H6.20389L8 0Z" fill="#001F5F"/>
            </svg>
            <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 0L9.79611 5.52786H15.6085L10.9062 8.94427L12.7023 14.4721L8 11.0557L3.29772 14.4721L5.09383 8.94427L0.391548 5.52786H6.20389L8 0Z" fill="#001F5F"/>
            </svg>
            <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 0L9.79611 5.52786H15.6085L10.9062 8.94427L12.7023 14.4721L8 11.0557L3.29772 14.4721L5.09383 8.94427L0.391548 5.52786H6.20389L8 0Z" fill="#001F5F"/>
            </svg>
            <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 0L9.79611 5.52786H15.6085L10.9062 8.94427L12.7023 14.4721L8 11.0557L3.29772 14.4721L5.09383 8.94427L0.391548 5.52786H6.20389L8 0Z" fill="#001F5F"/>
            </svg>
            <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="half-star-{{ section.id }}">
                  <stop offset="60%" stop-color="#001F5F"/>
                  <stop offset="60%" stop-color="#CCCCCC"/>
                </linearGradient>
              </defs>
              <path d="M8 0L9.79611 5.52786H15.6085L10.9062 8.94427L12.7023 14.4721L8 11.0557L3.29772 14.4721L5.09383 8.94427L0.391548 5.52786H6.20389L8 0Z" fill="url(#half-star-{{ section.id }})"/>
            </svg>
          </div>
          <div class="testimonials__rating-text">
            <span class="testimonials__rating-number">{{ star_rating }}</span>
            <span class="testimonials__rating-label">{{ star_label }}</span>
          </div>
        </div>

        {%- if heading != blank -%}
          <h2 class="testimonials__heading">{{ heading | escape }}</h2>
        {%- endif -%}

        {%- if description != blank -%}
          <p class="testimonials__description">{{ description | escape }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} Category filter tabs {%- endcomment -%}
      {%- if tabs.size > 0 -%}
        <div class="testimonials__tab-list" role="tablist" aria-label="Testimonial categories">
          {%- for tab in tabs -%}
            <button
              class="testimonials__tab{% if forloop.first %} testimonials__tab--active{% endif %}"
              role="tab"
              aria-selected="{{ forloop.first }}"
              data-label="{{ tab.settings.label | escape }}"
              on:click="/handleTabClick"
              on:keydown="/handleTabKeydown"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              {{ tab.shopify_attributes }}
            >
              {{ tab.settings.label | escape }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Testimonial cards row {%- endcomment -%}
      {%- if testimonials.size > 0 -%}
        <div class="testimonials__cards-row">
          {%- for testimonial in testimonials -%}
            <div
              class="testimonials__card"
              data-category="{{ testimonial.settings.category | escape }}"
              {{ testimonial.shopify_attributes }}
            >
              <div class="testimonials__card-quote">
                {{ testimonial.settings.quote | escape }}
              </div>
              <div class="testimonials__card-info">
                <div class="testimonials__card-reviewer">
                  {%- if testimonial.settings.reviewer_name != blank -%}
                    <span class="testimonials__card-name">{{ testimonial.settings.reviewer_name | escape }}</span>
                  {%- endif -%}
                  <div class="testimonials__card-verified">
                    <svg class="testimonials__card-checkmark" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <circle cx="8" cy="8" r="8" fill="#28A745"/>
                      <path d="M5 8L7 10L11 6" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="testimonials__card-reviewer-label">{{ testimonial.settings.reviewer_label | escape }}</span>
                  </div>
                </div>
                {%- if testimonial.settings.product_name != blank -%}
                  <div class="testimonials__card-product">
                    {%- if testimonial.settings.product_url != blank -%}
                      <a href="{{ testimonial.settings.product_url }}" class="testimonials__card-product-link">
                        {{ testimonial.settings.product_name | escape }}
                      </a>
                    {%- else -%}
                      <span class="testimonials__card-product-link">
                        {{ testimonial.settings.product_name | escape }}
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Arrow navigation {%- endcomment -%}
      <div class="testimonials__arrows">
        <button
          class="testimonials__arrow testimonials__arrow--left"
          aria-label="Scroll testimonials left"
          on:click="/handleArrowLeft"
          disabled
        >
          <svg width="29" height="32" viewBox="0 0 29 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M21.7503 10.6667L26.5837 16.0001M26.5837 16.0001L21.7503 21.3334M26.5837 16.0001H2.41699" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          class="testimonials__arrow testimonials__arrow--right"
          aria-label="Scroll testimonials right"
          on:click="/handleArrowRight"
        >
          <svg width="29" height="32" viewBox="0 0 29 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M21.7503 10.6667L26.5837 16.0001M26.5837 16.0001L21.7503 21.3334M26.5837 16.0001H2.41699" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</testimonials-component>

<script src="{{ 'testimonials.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
.testimonials {
  background-color: var(--testimonials-bg, #F2F2F2);
}

.testimonials__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40px;
}

.testimonials__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  max-width: 1440px;
  width: 100%;
}

.testimonials__stars-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
}

.testimonials__stars {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4px;
}

.testimonials__stars svg {
  width: 16px;
  height: 15px;
}

.testimonials__rating-text {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4px;
  font-family: var(--font-heading--family);
  font-size: 12px;
  font-weight: 600;
  line-height: 17px;
  color: #151515;
}

.testimonials__heading {
  font-family: var(--font-heading--family);
  font-size: 32px;
  font-weight: 600;
  line-height: 45px;
  letter-spacing: -0.64px;
  text-align: center;
  color: #151515;
  margin: 0;
  width: 100%;
}

.testimonials__description {
  font-family: var(--font-body--family);
  font-size: 16px;
  font-weight: 400;
  line-height: 22px;
  text-align: center;
  color: #4F5055;
  margin: 0;
  width: 100%;
}

/* Tab list */
.testimonials__tab-list {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
}

.testimonials__tab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 4px 24px;
  border-radius: 4px;
  border: 1px solid #005695;
  background-color: #FFFFFF;
  color: #151515;
  font-family: var(--font-body--family);
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
  text-align: center;
  cursor: pointer;
  min-height: 40px;
  white-space: nowrap;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.testimonials__tab:hover {
  opacity: 0.85;
}

.testimonials__tab:focus-visible {
  outline: 2px solid var(--testimonials-active-tab, #081D4D);
  outline-offset: 2px;
}

.testimonials__tab--active {
  background-color: var(--testimonials-active-tab, #081D4D);
  color: #FFFFFF;
  border-color: var(--testimonials-active-tab, #081D4D);
}

/* Cards row */
.testimonials__cards-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32px;
  padding-inline-start: 64px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  width: 100%;
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.testimonials__cards-row::-webkit-scrollbar {
  display: none;
}

/* Card */
.testimonials__card {
  flex: 0 0 306px;
  min-width: 306px;
  background-color: #FFFFFF;
  border-radius: 4px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 48px;
  scroll-snap-align: start;
}

.testimonials__card-quote {
  font-family: var(--font-body--family);
  font-size: 16px;
  font-weight: 400;
  line-height: 22px;
  color: #151515;
}

.testimonials__card-info {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.testimonials__card-reviewer {
  display: flex;
  flex-direction: column;
  gap: 4px;
  justify-content: center;
}

.testimonials__card-name {
  font-family: var(--font-heading--family);
  font-size: 16px;
  font-weight: 600;
  line-height: 22px;
  color: #151515;
}

.testimonials__card-verified {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4px;
}

.testimonials__card-checkmark {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

.testimonials__card-reviewer-label {
  font-family: var(--font-body--family);
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
  color: #151515;
}

.testimonials__card-product {
  display: flex;
}

.testimonials__card-product-link {
  font-family: var(--font-body--family);
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
  color: #005695;
  text-decoration: underline;
}

.testimonials__card-product-link:hover {
  text-decoration: none;
}

/* Arrows */
.testimonials__arrows {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 24px;
}

.testimonials__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  color: #151515;
  min-width: 44px;
  min-height: 44px;
  transition: opacity 0.2s ease;
}

.testimonials__arrow:disabled {
  color: #A7A9B4;
  cursor: default;
}

.testimonials__arrow:focus-visible {
  outline: 2px solid var(--testimonials-active-tab, #081D4D);
  outline-offset: 2px;
  border-radius: 4px;
}

.testimonials__arrow--left svg {
  transform: rotate(180deg);
}

/* Mobile responsive */
@media screen and (max-width: 749px) {
  .testimonials__inner {
    gap: 24px;
  }

  .testimonials__heading {
    font-size: 24px;
    line-height: 34px;
    letter-spacing: -0.48px;
  }

  .testimonials__description {
    font-size: 14px;
    line-height: 20px;
  }

  .testimonials__tab-list {
    flex-wrap: nowrap;
    justify-content: flex-start;
    overflow-x: auto;
    padding-inline: 16px;
    -ms-overflow-style: none;
    scrollbar-width: none;
    width: 100%;
  }

  .testimonials__tab-list::-webkit-scrollbar {
    display: none;
  }

  .testimonials__cards-row {
    padding-inline-start: 16px;
    gap: 16px;
  }

  .testimonials__card {
    flex: 0 0 calc(80vw - 32px);
    min-width: calc(80vw - 32px);
    gap: 32px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.testimonials",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "t:content.content"
    },
    {
      "type": "text",
      "id": "star_rating",
      "label": "t:settings.star_rating",
      "default": "4.6"
    },
    {
      "type": "text",
      "id": "star_label",
      "label": "t:settings.star_label",
      "default": "Stars"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "400,000+ LiFePO4 Battery Packs In the Field"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:names.description",
      "default": "Power Lights, fans, furnace, water pump, refrigerator, satellite Internet & everyday essentials reilably through the night"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#F2F2F2"
    },
    {
      "type": "color",
      "id": "active_tab_color",
      "label": "t:settings.active_tab_color",
      "default": "#081D4D"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page_width" },
        { "value": "full-width", "label": "t:options.full_width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 64,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:names.tab",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.label",
          "default": "Category"
        }
      ]
    },
    {
      "type": "testimonial",
      "name": "t:names.testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:settings.quote",
          "default": "This battery was easy to install and has fit perfectly into my setup."
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "t:settings.reviewer_name",
          "default": "Reviewer Name"
        },
        {
          "type": "text",
          "id": "reviewer_label",
          "label": "t:settings.reviewer_label",
          "default": "Verified Reviewer"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "t:settings.product_name"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "t:settings.link"
        },
        {
          "type": "text",
          "id": "category",
          "label": "t:settings.category",
          "info": "Must match a tab label exactly to link this testimonial to that tab."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.testimonials",
      "category": "t:categories.other_sections",
      "settings": {
        "star_rating": "4.6",
        "star_label": "Stars",
