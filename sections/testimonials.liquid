        "description": "Power Lights, fans, furnace, water pump, refrigerator, satellite Internet & everyday essentials reilably through the night",
        "background_color": "#F2F2F2",
        "active_tab_color": "#081D4D",
        "padding-block-start": 64,
        "padding-block-end": 64
      },
      "blocks": [
        { "type": "tab", "settings": { "label": "RV" } },
        { "type": "tab", "settings": { "label": "Marine" } },
        { "type": "tab", "settings": { "label": "Trucking" } },
